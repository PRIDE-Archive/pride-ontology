    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UNIMOD_1000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UNIMOD_0"/>
        <obo:IAO_0000115>Azidohomoalanine (AHA) bound to propargylglycine-NH2 (alkyne).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>approved</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>date_time_modified</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>date_time_posted</oboInOwl:hasDbXref>
