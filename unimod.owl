        <oboInOwl:hasDbXref>record_id</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>spec_1_classification</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>spec_1_group</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>spec_1_hidden</oboInOwl:hasDbXref>
