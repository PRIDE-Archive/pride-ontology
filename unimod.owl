        <obo:IAO_0000115>Removal of initiator methionine from protein N-terminus, then acetylation of the new N-terminus.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>approved</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>date_time_modified</oboInOwl:hasDbXref>
